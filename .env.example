# Copy to .env and fill in a key to score with a real LLM.
# Leave blank to run entirely on the deterministic mock provider — the full app
# still works end-to-end, just with reproducible mock scores instead of live ones.

# OpenRouter (default provider) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional alternates (switch with FRISK_PROVIDER=nvidia|anthropic|mock)
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=

# --- optional tuning ---
# FRISK_PROVIDER=openrouter        # openrouter | nvidia | anthropic | mock
# FRISK_AGENT_MAX_STEPS=12         # tool-calling turns before the agent must finalize
# FRISK_CONFIDENCE_THRESHOLD=0.60  # below this, a case goes to the human review queue
# FRISK_REDIS_URL=redis://localhost:6379/0
